# AI API Configuration (Never commit actual keys!)
# Get Ollama API key from https://ollama.ai or your preferred provider
AI_API_KEY=your_api_key_here
AI_BASE_URL=http://localhost:11434/api/generate
AI_MODEL=mistral

# Database Configuration - Update with your MySQL credentials
DB_URL=jdbc:mysql://localhost:3306/ai_content_writer?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Optional Logging Level (DEBUG for development, INFO/WARN/ERROR for production)
logging.level.com.ai.contentwriter=INFO
spring.main.log-startup-banner=false
